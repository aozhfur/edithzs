{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#edith-cowan-university-diploma","title":"\u6fb3\u5927\u5229\u4e9a\u57c3\u8fea\u65af\u79d1\u6587\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08Edith Cowan University diploma\uff09\u6837\u672c\u6bd4\u5bf9\u53ca\u771f\u4f2a\u6838\u67e5\u8981\u70b9","text":"<p>\u5728\u6d77\u5916\u7559\u5b66\u5f52\u56fd\u3001\u5165\u53f8\u653f\u4f01\u5355\u4f4d\u6216\u529e\u7406\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\uff08\u7559\u670d\uff09\u8ba4\u8bc1\u65f6\uff0c\u6fb3\u5927\u5229\u4e9a\u57c3\u8fea\u65af\u79d1\u6587\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08Edith Cowan University diploma\uff09\u7684\u771f\u5b9e\u6027\u4e0e\u5408\u89c4\u6027\u662f\u96c7\u4e3b\u548cHR\u5ba1\u6838\u7684\u91cd\u4e2d\u4e4b\u91cd\u3002\u57c3\u8fea\u65af\u79d1\u6587\u5927\u5b66\uff08ECU\uff09\u4f5c\u4e3a\u897f\u6fb3\u77e5\u540d\u7684\u516c\u7acb\u7efc\u5408\u6027\u5927\u5b66\uff0c\u5176\u5de5\u7a0b\u3001\u5546\u79d1\u53ca\u62a4\u7406\u7b49\u4e13\u4e1a\u7684\u5b66\u4f4d\u8bc1\u4e66\u5728\u56fd\u9645\u4e0a\u62e5\u6709\u6781\u9ad8\u7684\u8ba4\u53ef\u5ea6\u3002</p> <p></p> <p>\u7531\u4e8e\u8fd1\u5e74\u6765\u6d77\u5916\u5b66\u5386\u9020\u5047\u6280\u672f\u4e0d\u65ad\u5347\u7ea7\uff0c\u5982\u4f55\u51c6\u786e\u8bc6\u522bECU\u6bd5\u4e1a\u8bc1\u7684\u771f\u4f2a\u3001\u638c\u63e1\u5176\u6838\u5fc3\u9632\u4f2a\u7279\u5f81\uff0c\u6210\u4e3a\u7559\u5b66\u751f\u53ca\u4eba\u529b\u8d44\u6e90\u98ce\u63a7\u90e8\u95e8\u7684\u5fc5\u4fee\u8bfe\u3002\u672c\u6587\u5c06\u57fa\u4e8e\u6700\u65b0\u7684ECU\u5b98\u65b9\u6837\u672c\uff0c\u6df1\u5ea6\u89e3\u6790\u5176\u6bd5\u4e1a\u8bc1\u4e66\u7684\u6392\u7248\u5e03\u5c40\u3001\u7269\u7406\u9632\u4f2a\u6280\u672f\uff0c\u5e76\u63d0\u4f9b\u6743\u5a01\u7684\u7ebf\u4e0a\u771f\u4f2a\u6838\u67e5\u8def\u5f84\u3002</p>"},{"location":"#_1","title":"\u4e00\u3001 \u57c3\u8fea\u65af\u79d1\u6587\u5927\u5b66\u6bd5\u4e1a\u8bc1\u7684\u6838\u5fc3\u677f\u5757\u4e0e\u6392\u7248\u7ec6\u8282\u6bd4\u5bf9","text":"<p>\u6807\u51c6\u7684\u57c3\u8fea\u65af\u79d1\u6587\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\u91c7\u7528\u7684\u662f\u9ad8\u6e05\u7279\u79cd\u7eb8\u5f20\uff0c\u5176\u6574\u4f53\u89c6\u89c9\u5e03\u5c40\u4e25\u8c28\u3001\u6bd4\u4f8b\u534f\u8c03\u3002\u4ee5\u4e0b\u4e3a\u6b63\u7248\u8bc1\u4e66\u7531\u4e0a\u81f3\u4e0b\u7684\u6838\u5fc3\u677f\u5757\u89e3\u6790\uff1a</p>"},{"location":"#1-university-crest-name","title":"1. \u6821\u5fbd\u4e0e\u6821\u540d\uff08University Crest &amp; Name\uff09","text":"<ul> <li>\u9ed1\u5929\u9e45\u6821\u5fbd\uff1aECU\u7684\u6821\u5fbd\u7531\u4e24\u53ea\u9762\u5bf9\u9762\u7684\u9ed1\u5929\u9e45\uff08\u897f\u6fb3\u7684\u8c61\u5f81\uff09\u73af\u7ed5\u76fe\u724c\u7ec4\u6210\u3002\u6b63\u7248\u8bc1\u4e66\u9876\u90e8\u7684\u6821\u5fbd\u5370\u5237\u6781\u5ea6\u7ec6\u817b\uff0c\u76fe\u724c\u5185\u90e8\u7684\u5357\u5341\u5b57\u661f\u4e0e\u5c04\u7ebf\u7ebf\u6761\u5206\u660e\uff0c\u65e0\u4efb\u4f55\u6a21\u7cca\u6216\u91cd\u5f71\u3002</li> <li>\u6807\u51c6\u5b57\u4f53\uff1a\u6821\u540d\u201cEDITH COWAN UNIVERSITY\u201d\u4ee5\u53ca\u4e0b\u65b9\u7684\u201cWESTERN AUSTRALIA\u201d\u91c7\u7528\u4e13\u5c5e\u7684\u886c\u7ebf\u5b57\u4f53\uff0c\u5b57\u8ddd\u56fa\u5b9a\u3002\u5047\u8bc1\u5f80\u5f80\u5728\u5b57\u6bcd\u7684\u7c97\u7ec6\u6bd4\u4f8b\u6216\u886c\u7ebf\u5f27\u5ea6\u4e0a\u9732\u51fa\u9a6c\u811a\u3002</li> </ul>"},{"location":"#2","title":"2. \u6bd5\u4e1a\u751f\u4e2a\u4eba\u4fe1\u606f\u4e0e\u5b66\u4f4d\u540d\u79f0","text":"<ul> <li>\u6388\u4e88\u6587\u672c\uff1a\u6821\u540d\u4e0b\u65b9\u4e3a\u6bd5\u4e1a\u751f\u59d3\u540d\uff08\u901a\u5e38\u7ecf\u8fc7\u52a0\u7c97\u6216\u7279\u6b8a\u5b57\u4f53\u5904\u7406\uff09\uff0c\u63a5\u7740\u662f\u6807\u51c6\u53d9\u8ff0\u6587\u672c\uff0c\u5982\u201cHAVING FULFILLED ALL REQUIREMENTS PRESCRIBED BY THE UNIVERSITY HAS THIS DAY BEEN ADMITTED TO THE DEGREE OF...\u201d\u3002</li> <li>\u5b66\u4f4d\u4e3b\u6807\u9898\uff1a\u8bc1\u4e66\u4e2d\u5fc3\u4f4d\u7f6e\u4f1a\u660e\u786e\u6807\u51fa\u6240\u83b7\u5b66\u4f4d\u3002\u4f8b\u5982\uff1aMASTER OF ENGINEERING\uff08\u5de5\u7a0b\u7855\u58eb\uff09\uff0c\u5e76\u52a0\u7c97\u52a0\u5927\u663e\u793a\u3002</li> <li>\u4e13\u4e1a\u65b9\u5411\uff08Specialisation\uff09\uff1a\u5982\u679c\u8be5\u5b66\u4f4d\u5305\u542b\u5177\u4f53\u7814\u7a76\u65b9\u5411\uff0c\u4f1a\u7d27\u968f\u5176\u540e\u8be6\u7ec6\u5217\u51fa\uff0c\u5982\u201cSPECIALISATION IN INSTRUMENTATION CONTROL AND AUTOMATION ENGINEERING\u201d\uff08\u4eea\u8868\u63a7\u5236\u4e0e\u81ea\u52a8\u5316\u5de5\u7a0b\u65b9\u5411\uff09\u3002</li> <li>\u8363\u8a89\u5212\u5206\uff08Distinction\uff09\uff1a\u5bf9\u4e8e\u6210\u7ee9\u4f18\u5f02\u7684\u6bd5\u4e1a\u751f\uff0c\u8bc1\u4e66\u4e0a\u4f1a\u7279\u522b\u5370\u6709\u201cWITH DISTINCTION\u201d\u7b49\u8363\u8a89\u5b57\u6837\uff0c\u6b64\u5904\u7684\u5b57\u4f53\u6392\u7248\u4e0e\u524d\u6587\u4fdd\u6301\u9ad8\u5ea6\u4e00\u81f4\u3002</li> </ul>"},{"location":"#3","title":"3. \u5e95\u90e8\u7b7e\u7ae0\u4e0e\u552f\u4e00\u8bc6\u522b\u7801","text":"<ul> <li>\u5b98\u5458\u7b7e\u540d\uff1a\u8bc1\u4e66\u5de6\u4e0b\u65b9\u5370\u6709\u5b66\u6821\u9ad8\u5c42\u7ba1\u7406\u4eba\u5458\u7684\u7b7e\u540d\uff0c\u901a\u5e38\u5305\u62ec\u6821\u957f\uff08CHANCELLOR\uff09\u548c\u526f\u6821\u957f\uff08VICE-CHANCELLOR\uff09\u3002\u6b63\u7248\u7b7e\u540d\u4e3a\u9ad8\u6e05\u7535\u5b50\u7b7e\u6216\u5b9e\u7269\u624b\u7b7e\u626b\u63cf\uff0c\u7ebf\u6761\u5706\u6da6\u81ea\u7136\u3002</li> <li>\u552f\u4e00\u8bc1\u4e66\u7f16\u53f7\uff1a\u5e95\u90e8\u4e2d\u592e\u5370\u6709\u4e00\u884c\u7eaf\u6570\u5b57\u7684\u6bd5\u4e1a\u8bc1\u552f\u4e00\u8bc6\u522b\u7801\uff08\u4f8b\u5982\uff1a2007176793\uff09\u3002\u8be5\u7f16\u53f7\u662f\u8bc1\u4e66\u7684\u201c\u8eab\u4efd\u8bc1\u53f7\u201d\uff0c\u7528\u4e8e\u5728\u5b66\u6821\u6570\u636e\u5e93\u4e2d\u8fdb\u884c\u7cbe\u51c6\u68c0\u7d22\u3002</li> <li>\u94a2\u5370\u4e0e\u8bf4\u660e\u6587\u672c\uff1a\u53f3\u4e0b\u65b9\u4e3a\u9ad8\u7cbe\u5bc6\u538b\u5370\u7684\u7ea2\u8910\u8272\u6216\u6df1\u7ea2\u8272\u6bd5\u4e1a\u5178\u793c\u94a2\u5370\uff08Graduation Seal\uff09\uff0c\u4e0b\u65b9\u914d\u6709\u5fae\u578b\u6587\u672c\uff0c\u6807\u660e\u94a2\u5370\u52a0\u76d6\u7684\u5177\u4f53\u65e5\u671f\uff08\u5982\uff1aTENTH DAY OF DECEMBER, 2021\uff09\u3002</li> </ul>"},{"location":"#ecu-degreehr","title":"\u4e8c\u3001 ECU Degree\u9632\u4f2a\u4e09\u5927\u6838\u5fc3\u8981\u70b9\uff08HR\u5b9e\u64cd\u5fc5\u770b\uff09","text":"<p>\u666e\u901a\u7684\u5f69\u8272\u590d\u5370\u6216\u4f4e\u7aef\u4eff\u5192\u5f88\u96be\u5b8c\u5168\u8fd8\u539fECU\u5b98\u65b9\u8bc1\u4e66\u7684\u7269\u7406\u548c\u9632\u4f2a\u7ec6\u8282\u3002HR\u6216\u98ce\u63a7\u4eba\u5458\u5728\u8fdb\u884c\u6837\u672c\u6bd4\u5bf9\u65f6\uff0c\u5e94\u91cd\u70b9\u4ece\u4ee5\u4e0b\u4e09\u4e2a\u7ef4\u5ea6\u8fdb\u884c\u6838\u67e5\uff1a</p>"},{"location":"#1-microtext","title":"1. \u89e6\u89c9\u4e0e\u5fae\u578b\u6587\u5b57\uff08Microtext\uff09\u6838\u67e5","text":"<ul> <li>\u7eb8\u8d28\u8d28\u611f\uff1a\u6b63\u7248ECU\u6bd5\u4e1a\u8bc1\u4f7f\u7528\u91cd\u78c5\u9632\u4f2a\u7eb8\u5f20\uff0c\u6478\u4e0a\u53bb\u6709\u5fae\u5c0f\u7684\u7eb9\u7406\u611f\u548c\u539a\u91cd\u611f\uff0c\u800c\u5e76\u975e\u666e\u901aA4\u7eb8\u7684\u5e73\u6ed1\u5149\u6cfd\u3002</li> <li>\u5fae\u7f29\u5370\u5237\uff1a\u5728\u6821\u5fbd\u8fb9\u7f18\u3001\u8bc1\u4e66\u8fb9\u6846\u6216\u7279\u5b9a\u7ebf\u6761\u4e2d\uff0c\u6b63\u7248\u8bc1\u4e66\u5f80\u5f80\u5d4c\u5165\u4e86\u9ad8\u500d\u653e\u5927\u955c\u4e0b\u624d\u53ef\u89c1\u7684\u5fae\u578b\u82f1\u6587\u5b57\u6bcd\uff08Microtext\uff09\u3002\u5047\u8bc1\u7531\u4e8e\u5370\u5237\u8bbe\u5907\u5206\u8fa8\u7387\u9650\u5236\uff0c\u5728\u653e\u5927\u540e\u8fd9\u4e9b\u7ebf\u6761\u4f1a\u53d8\u6210\u8fde\u7eed\u7684\u865a\u7ebf\u6216\u58a8\u70b9\u3002</li> </ul>"},{"location":"#2-graduation-seal","title":"2. \u94a2\u5370\uff08Graduation Seal\uff09\u7684\u7acb\u4f53\u5ea6\u4e0e\u51f9\u51f8\u611f","text":"<ul> <li>\u8bc1\u4e66\u53f3\u4e0b\u89d2\u7684\u94a2\u5370\u662f\u9632\u4f2a\u7684\u6838\u5fc3\u3002\u6b63\u7248\u94a2\u5370\u662f\u901a\u8fc7\u9ad8\u538b\u7269\u7406\u6a21\u5177\u538b\u5370\u5728\u7eb8\u5f20\u4e0a\u7684\uff0c\u6b63\u9762\u7684\u56fe\u6848\u548c\u6587\u5b57\u5177\u6709\u660e\u663e\u7684\u51f9\u51f8\u7acb\u4f53\u611f\uff0c\u4e14\u7eb8\u5f20\u80cc\u9762\u4f1a\u6709\u5bf9\u5e94\u7684\u51f9\u9677\u75d5\u8ff9\u3002</li> <li>\u5982\u679c\u94a2\u5370\u53ea\u662f\u5e73\u9762\u7684\u6fc0\u5149\u6253\u5370\u56fe\u6848\uff0c\u6216\u8005\u51f9\u51f8\u611f\u6781\u5176\u5fae\u5f31\u3001\u8fb9\u7f18\u6a21\u7cca\uff0c\u5219\u8be5\u8bc1\u4e66\u5927\u6982\u7387\u5b58\u5728\u4f2a\u9020\u98ce\u9669\u3002</li> </ul>"},{"location":"#3_1","title":"3. \u5b57\u4f53\u95f4\u8ddd\u4e0e\u6392\u7248\u5bf9\u9f50\u7ebf","text":"<ul> <li>\u5b98\u65b9\u8bc1\u4e66\u5728\u51fa\u5382\u5370\u5237\u65f6\u6709\u4e25\u683c\u7684\u6392\u7248\u5bf9\u9f50\u6807\u51c6\u3002\u8bc1\u4e66\u7684\u6240\u6709\u6b63\u6587\u5c45\u4e2d\u5bf9\u9f50\uff0c\u6bb5\u843d\u95f4\u8ddd\u5b8c\u5168\u7b49\u6bd4\u4f8b\u3002</li> <li>\u5047\u8bc1\u5f80\u5f80\u5728\u6392\u7248\u5957\u7528\u6a21\u677f\u65f6\uff0c\u7531\u4e8e\u5b57\u6570\u4e0d\u540c\u5bfc\u81f4\u6574\u4f53\u89c6\u89c9\u91cd\u5fc3\u504f\u79fb\uff0c\u6216\u8005\u7b7e\u540d\u4e0e\u5934\u8854\u5b57\u6837\u5bf9\u9f50\u51fa\u73b0\u504f\u5dee\u3002</li> </ul>"},{"location":"#_2","title":"\u4e09\u3001 \u6743\u5a01\u7684\u6fb3\u5927\u5229\u4e9a\u7559\u5b66\u751f\u5b66\u5386\u771f\u4f2a\u6838\u67e5\u8def\u5f84","text":"<p>\u4ec5\u51ed\u8089\u773c\u548c\u7ecf\u9a8c\u6bd4\u5bf9\u6837\u672c\uff0c\u5b58\u5728\u4e00\u5b9a\u7684\u5c40\u9650\u6027\u3002\u8981\u5f7b\u5e95\u843d\u5b9e\u771f\u4f2a\u6838\u67e5\uff0c\u5fc5\u987b\u901a\u8fc7\u4ee5\u4e0b\u5b98\u65b9\u548c\u6743\u5a01\u6e20\u9053\u8fdb\u884c\u6570\u5b57\u5316\u9a8c\u8bc1\uff1a</p>"},{"location":"#1-ecu-online-verification","title":"1. \u57c3\u8fea\u65af\u79d1\u6587\u5927\u5b66\u5b98\u65b9\u7ebf\u4e0a\u9a8c\u8bc1\u7cfb\u7edf\uff08ECU Online Verification\uff09","text":"<p>\u6fb3\u5927\u5229\u4e9a\u7684\u9ad8\u6821\u666e\u904d\u5411\u96c7\u4e3b\u548c\u7b2c\u4e09\u65b9\u673a\u6784\u5f00\u653e\u4e86\u5728\u7ebf\u5b66\u5386\u9a8c\u8bc1\u670d\u52a1\u3002 *   \u64cd\u4f5c\u65b9\u6cd5\uff1a\u8bbf\u95eeECU\u5b98\u65b9\u7f51\u7ad9\u7684\u201cQualifications Verification\u201d\u6216\u201cGraduation Verification\u201d\u4e13\u5c5e\u9875\u9762\u3002 *   \u6240\u9700\u4fe1\u606f\uff1a\u8f93\u5165\u6bd5\u4e1a\u751f\u7684\u5168\u540d\uff08Full Name\uff09\u3001\u51fa\u751f\u65e5\u671f\uff08Date of Birth\uff09\u4ee5\u53ca\u8bc1\u4e66\u5e95\u90e8\u7684\u552f\u4e00\u8bc1\u4e66\u7f16\u53f7\uff08Student ID / Testamur Number\uff09\u3002 *   \u7ed3\u679c\u53cd\u9988\uff1a\u7cfb\u7edf\u4f1a\u81ea\u52a8\u5339\u914d\u6570\u636e\u5e93\uff0c\u82e5\u8bc1\u4e66\u771f\u5b9e\uff0c\u5c06\u76f4\u63a5\u663e\u793a\u8be5\u5b66\u751f\u7684\u6bd5\u4e1a\u65f6\u95f4\u3001\u6240\u5b66\u4e13\u4e1a\u53ca\u88ab\u6388\u4e88\u7684\u5b66\u4f4d\u540d\u79f0\u3002</p>"},{"location":"#2-my-equals","title":"2. My eQuals \u5e73\u53f0\u9a8c\u8bc1","text":"<p>My eQuals\u662f\u6fb3\u5927\u5229\u4e9a\u548c\u65b0\u897f\u5170\u6240\u6709\u5927\u5b66\u5171\u540c\u4f7f\u7528\u7684\u5b98\u65b9\u6570\u5b57\u53d6\u8bc1\u5e73\u53f0\u3002 *   \u8fd0\u4f5c\u673a\u5236\uff1aECU\u6bd5\u4e1a\u751f\u53ef\u4ee5\u901a\u8fc7My eQuals\u5e73\u53f0\u83b7\u5f97\u7531\u5b66\u6821\u5b98\u65b9\u76f4\u63a5\u9881\u53d1\u7684\u52a0\u5bc6\u6570\u5b57\u6bd5\u4e1a\u8bc1\u3001\u6210\u7ee9\u5355\u3002 *   \u6838\u67e5\u65b9\u5f0f\uff1a\u7559\u5b66\u751f\u53ef\u76f4\u63a5\u5411\u96c7\u4e3b\u6216HR\u53d1\u9001\u5e26\u6709My eQuals\u5b98\u65b9\u57df\u540d\u7684\u52a0\u5bc6\u94fe\u63a5\u3002HR\u70b9\u51fb\u94fe\u63a5\u5373\u53ef\u67e5\u770b\u65e0\u6cd5\u88ab\u7be1\u6539\u7684\u7535\u5b50\u7248\u5b66\u4f4d\u8bc1\u4e66\uff0c\u8fd9\u662f\u76ee\u524d100%\u89c4\u907f\u5047\u8bc1\u7684\u6700\u5feb\u6377\u65b9\u5f0f\u3002</p>"},{"location":"#3-cscse","title":"3. \u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\uff08CSCSE\uff09\u8ba4\u8bc1","text":"<p>\u5bf9\u4e8e\u5f52\u56fd\u843d\u6237\u3001\u8fdb\u5165\u56fd\u4f01\u6216\u516c\u52a1\u5458\u4f53\u5236\u7684\u7559\u5b66\u751f\u800c\u8a00\uff0c\u7559\u670d\u8ba4\u8bc1\u662f\u552f\u4e00\u7684\u5b98\u65b9\u786c\u6027\u6807\u51c6\u3002 *   \u6838\u67e5\u903b\u8f91\uff1a\u4e2d\u56fd\u7559\u670d\u4e2d\u5fc3\u5728\u6536\u5230\u5b66\u751f\u7684\u8ba4\u8bc1\u7533\u8bf7\u540e\uff0c\u4f1a\u76f4\u63a5\u5411\u6fb3\u5927\u5229\u4e9a\u57c3\u8fea\u65af\u79d1\u6587\u5927\u5b66\u7684\u6ce8\u518c\u5904\uff08Registry\uff09\u53d1\u51fd\u6216\u901a\u8fc7\u5b98\u65b9\u6570\u636e\u63a5\u53e3\u6838\u5bf9\u5b66\u7c4d\u3002 *   \u6700\u7ec8\u51ed\u8bc1\uff1a\u53ea\u8981\u7533\u8bf7\u4eba\u80fd\u591f\u51fa\u5177\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\u5f00\u5177\u7684\u300a\u56fd\u5916\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u4e66\u300b\uff0c\u4e14\u80fd\u5728\u7559\u670d\u5b98\u7f51\uff08http://cscse.edu.cn\uff09\u6838\u9a8c\u771f\u4f2a\uff0c\u5373\u4ee3\u8868\u5176ECU\u6bd5\u4e1a\u8bc1\u771f\u5b9e\u65e0\u8bef\u3002</p>"},{"location":"#_3","title":"\u56db\u3001 \u7ed3\u8bed","text":"<p>\u5728\u7504\u522b\u6fb3\u5927\u5229\u4e9a\u57c3\u8fea\u65af\u79d1\u6587\u5927\u5b66\u6bd5\u4e1a\u8bc1\u65f6\uff0cHR\u548c\u7528\u4eba\u5355\u4f4d\u5e94\u5f53\u91c7\u53d6\u201c\u7269\u7406\u7279\u5f81\u521d\u6b65\u7b5b\u67e5 + \u5b98\u65b9\u6e20\u9053\u6570\u5b57\u5316\u6838\u9a8c\u201d\u7684\u53cc\u91cd\u6807\u51c6\u3002\u6b63\u7248\u8bc1\u4e66\u5728\u7eb8\u5f20\u3001\u6821\u5fbd\u5370\u5237\u3001\u94a2\u5370\u5de5\u827a\u4e0a\u5177\u5907\u6781\u9ad8\u7684\u5de5\u827a\u58c1\u5792\uff0c\u800c\u901a\u8fc7 ECU\u5b98\u7f51\u9a8c\u8bc1\u7cfb\u7edf \u6216 My eQuals \u5e73\u53f0 \u8fdb\u884c\u5728\u7ebf\u6bd4\u5bf9\uff0c\u5219\u662f\u5835\u7edd\u5047\u8bc1\u98ce\u9669\u3001\u786e\u4fdd\u4eba\u4e8b\u5408\u89c4\u7684\u7ec8\u6781\u5229\u5668\u3002</p>"}]}